# Groq API Key
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudflare Turnstile Site Key (Public)
# Get from: https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AA_your_site_key_here

# Cloudflare Turnstile Secret Key (Private)
# Get from: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=0x4AB_your_secret_key_here

# Optional: Google Sheets Webhook URL for email collection
# See EMAIL_STORAGE.md for setup guide
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_WEBHOOK_URL
